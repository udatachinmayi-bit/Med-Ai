rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and create/update ONLY their own profile document.
    // This is required for the "createUserProfile" call that runs right
    // after signup / first Google sign-in (src/services/auth.ts).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
